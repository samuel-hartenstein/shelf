#: static/js/item_edit.js:28 static/js/item_edit.js:46
msgid "Point the camera at a 978 or 979 ISBN barcode."
msgstr "Halte die Kamera auf einen ISBN-Barcode, der mit 978 oder 979 beginnt."

#: static/js/item_edit.js:34 static/js/item_edit.js:121
msgid "Starting camera…"
msgstr "Kamera startet …"

#: static/js/item_edit.js:53 static/js/item_edit.js:140 static/js/scan.js:360
msgid "Camera requires HTTPS. Open Shelf through an HTTPS reverse proxy, or leave SHELF_TLS on."
msgstr "Die Kamera braucht HTTPS. Öffne Shelf über einen HTTPS-Reverse-Proxy oder lass SHELF_TLS an."

#: static/js/item_edit.js:55 static/js/item_edit.js:142 static/js/scan.js:362
msgid "Camera access denied. Check browser permissions for this site."
msgstr "Kein Zugriff auf die Kamera. Prüfe die Browser-Berechtigungen für diese Seite."

#: static/js/item_edit.js:71
msgid "That barcode is not a 978/979 ISBN. Try again."
msgstr "Dieser Barcode ist keine ISBN mit 978/979. Versuch es noch einmal."

#: static/js/item_edit.js:115 static/js/item_edit.js:133
msgid "Point the camera at a UPC-A or EAN-13 retail barcode."
msgstr "Halte die Kamera auf einen EAN-13- oder UPC-A-Barcode."

#: static/js/item_edit.js:158
msgid "That is not a valid UPC-A / EAN-13 retail barcode. Try again."
msgstr "Das ist kein gültiger EAN-13- / UPC-A-Barcode. Versuch es noch einmal."

