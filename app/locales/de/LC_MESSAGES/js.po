#: static/js/scan.js:64
msgid "Add Items"
msgstr "Einträge hinzufügen"

#: static/js/scan.js:64
msgid "Scan barcodes to add items to your collection."
msgstr "Scanne Barcodes, um Einträge zur Sammlung hinzuzufügen."

#: static/js/scan.js:65
msgid "Add to Wishlist"
msgstr "Auf die Wunschliste"

#: static/js/scan.js:65
msgid "Scan to save items you want but haven't bought yet."
msgstr "Scanne, was du dir wünschst, aber noch nicht gekauft hast."

#: static/js/scan.js:66
msgid "Lend Items"
msgstr "Einträge verleihen"

#: static/js/scan.js:66
msgid "Select a borrower, then scan items to check them out."
msgstr "Wähle eine Person aus und scanne dann, was du verleihst."

#: static/js/scan.js:67
msgid "Return Items"
msgstr "Einträge zurücknehmen"

#: static/js/scan.js:67
msgid "Scan items to check them back in."
msgstr "Scanne, was zurückgegeben wurde."

#: static/js/scan.js:68
msgid "Move Items"
msgstr "Einträge verschieben"

#: static/js/scan.js:68
msgid "Select a target location, then scan items to move them."
msgstr "Wähle einen Zielort aus und scanne dann, was dorthin kommt."

#: static/js/scan.js:69
msgid "Inventory Audit"
msgstr "Inventur"

#: static/js/scan.js:69
msgid "Select a location and scan every item you find there. Start an audit to get a report."
msgstr "Wähle einen Ort und scanne alles, was dort steht. Starte eine Inventur, um einen Bericht zu bekommen."

#: static/js/scan.js:70
msgid "Scan to check if an item is in your collection. No changes are made."
msgstr "Scanne, um nachzusehen, ob etwas schon in der Sammlung ist. Es wird nichts geändert."

#: static/js/scan.js:71
msgid "Scan to mark items as read or completed."
msgstr "Scanne, um Einträge als gelesen oder gespielt zu markieren."

#: static/js/scan.js:94
msgid "Could not load recent scans"
msgstr "Die letzten Scans konnten nicht geladen werden"

