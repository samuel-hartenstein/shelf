msgstr "Wähle unten das passende Spiel"

#: static/js/scan.js:465
msgid "Choose the matching book below"
msgstr "Wähle unten das passende Buch"

#: static/js/scan.js:465
msgid "Type the five digits below"
msgstr "Gib unten die fünf Ziffern ein"

